#!/bin/sh
# CPU usage since the previous run, from /proc/stat. Left click: htop.
. sb-theme

case $BUTTON in
	1) setsid -f "$TERMINAL" -e htop ;;
esac

cache=${XDG_RUNTIME_DIR:-/tmp}/sb-cpu
read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
total=$((user + nice + system + idle + iowait + irq + softirq + steal))
busy=$((total - idle - iowait))

if [ -r "$cache" ]; then
	read -r ptotal pbusy < "$cache"
else
	ptotal=0 pbusy=0
fi
echo "$total $busy" > "$cache"

dt=$((total - ptotal))
[ "$dt" -gt 0 ] || dt=1
printf '%s󰻠 %s%d%%\n' "$ACC" "$RST" $((100 * (busy - pbusy) / dt))
