#!/bin/sh
# Battery capacity and power state: a bolt while charging, a plug on the charger but not charging
# (TLP's charge threshold reached, or full), the level on battery, red at 15% or less.
# Prints nothing without a battery.
. sb-theme

for bat in /sys/class/power_supply/BAT*; do
	[ -r "$bat/capacity" ] || continue
	cap=$(cat "$bat/capacity")
	status=$(cat "$bat/status")

	if [ "$status" = Charging ]; then
		printf '%s%d%%\n' "$(ic "$C_BRI" )" "$cap"
		exit 0
	fi

	if [ "$status" = "Not charging" ] || [ "$status" = Full ]; then
		printf '%s%d%%\n' "$(ic "$C_BAT" )" "$cap"
		exit 0
	fi

	# empty, quarter, half, three quarters, full
	if [ "$cap" -ge 88 ]; then icon=
	elif [ "$cap" -ge 63 ]; then icon=
	elif [ "$cap" -ge 38 ]; then icon=
	elif [ "$cap" -ge 13 ]; then icon=
	else icon=
	fi

	if [ "$cap" -le 15 ]; then
		printf '%s^c%s^%d%%%s\n' "$(ic "$C_WARN" "$icon")" "$C_WARN" "$cap" "$RST"
	else
		printf '%s%d%%\n' "$(ic "$C_BAT" "$icon")" "$cap"
	fi
	exit 0
done
